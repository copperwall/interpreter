// Shapes: a small class hierarchy showing inheritance, method overriding,
// `super` calls, and dynamic dispatch (the base class's describe() calls
// area()/perimeter(), which resolve to whichever subclass `this` really is).

// ---- prelude: number formatting (clox has no num->string conversion) ----
// Copied verbatim into each example that needs it, since clox has no imports.
fun floor(x) {
  if (x < 0) {
    var f = -floor(-x);
    if (f != x) return f - 1;
    return f;
  }
  // Greedily add powers of two: O(log x), no native floor needed.
  var p = 1;
  while (p * 2 <= x) p = p * 2;
  var r = 0;
  while (p >= 1) {
    if (r + p <= x) r = r + p;
    p = p / 2;
  }
  return r;
}
fun mod(a, b) { return a - b * floor(a / b); }
fun digit(d) {
  if (d == 0) return "0"; if (d == 1) return "1"; if (d == 2) return "2";
  if (d == 3) return "3"; if (d == 4) return "4"; if (d == 5) return "5";
  if (d == 6) return "6"; if (d == 7) return "7"; if (d == 8) return "8";
  return "9";
}
// Integer -> string.
fun str(n) {
  if (n < 0) return "-" + str(-n);
  if (n < 10) return digit(n);
  var q = floor(n / 10);
  return str(q) + digit(n - q * 10);
}
// Number -> string with a fixed number of decimal places.
fun fixed(n, places) {
  if (n < 0) return "-" + fixed(-n, places);
  var scale = 1;
  for (var i = 0; i < places; i = i + 1) scale = scale * 10;
  var v = floor(n * scale + 0.5);
  var whole = floor(v / scale);
  var f = v - whole * scale;
  var s = "";
  for (var i = 0; i < places; i = i + 1) {
    scale = scale / 10;
    var d = floor(f / scale);
    s = s + digit(d);
    f = f - d * scale;
  }
  if (places == 0) return str(whole);
  return str(whole) + "." + s;
}
// Integers print plainly, everything else with 3 decimals.
fun fmt(n) {
  if (floor(n) == n) return str(n);
  return fixed(n, 3);
}
// -------------------------------------------------------------------------
fun sqrt(x) {
  if (x == 0) return 0;
  var g = x;
  for (var i = 0; i < 40; i = i + 1) g = (g + x / g) / 2;
  return g;
}

var PI = 3.14159265358979;

class Shape {
  init(name) { this.name = name; }
  area() { return 0; }
  perimeter() { return 0; }
  // Template method: written once, works for every subclass.
  describe() {
    return this.name + ": area=" + fixed(this.area(), 2) +
           " perimeter=" + fixed(this.perimeter(), 2);
  }
}

class Circle < Shape {
  init(r) {
    super.init("Circle");
    this.r = r;
  }
  area() { return PI * this.r * this.r; }
  perimeter() { return 2 * PI * this.r; }
}

class Rect < Shape {
  init(w, h) {
    super.init("Rect");
    this.w = w;
    this.h = h;
  }
  area() { return this.w * this.h; }
  perimeter() { return 2 * (this.w + this.h); }
  describe() {
    return super.describe() + " (" + str(this.w) + "x" + str(this.h) + ")";
  }
}

// Three levels deep: Square -> Rect -> Shape.
class Square < Rect {
  init(side) {
    super.init(side, side);
    this.name = "Square";
  }
  describe() { return super.describe() + " [regular]"; }
}

class Triangle < Shape {
  init(a, b, c) {
    super.init("Triangle");
    this.a = a;
    this.b = b;
    this.c = c;
  }
  perimeter() { return this.a + this.b + this.c; }
  area() {
    // Heron's formula
    var s = this.perimeter() / 2;
    return sqrt(s * (s - this.a) * (s - this.b) * (s - this.c));
  }
}

// A linked list to hold the shapes (clox has no arrays).
class Node {
  init(value, next) {
    this.value = value;
    this.next = next;
  }
}

var shapes = nil;
fun add(shape) { shapes = Node(shape, shapes); }

add(Triangle(3, 4, 5));
add(Square(4));
add(Rect(3, 7));
add(Circle(1));
add(Circle(2.5));

print "== Every shape describes itself ==";
var total = 0;
var largest = nil;
for (var n = shapes; n != nil; n = n.next) {
  var s = n.value;
  print s.describe();
  total = total + s.area();
  if (largest == nil or s.area() > largest.area()) largest = s;
}
print "";
print "Total area: " + fixed(total, 2);
print "Largest:    " + largest.describe();

// Insertion sort by area, smallest first, using a comparator closure.
fun sortBy(list, less) {
  var sorted = nil;
  for (var n = list; n != nil; n = n.next) {
    var v = n.value;
    if (sorted == nil or less(v, sorted.value)) {
      sorted = Node(v, sorted);
    } else {
      var cur = sorted;
      while (cur.next != nil and !less(v, cur.next.value)) cur = cur.next;
      cur.next = Node(v, cur.next);
    }
  }
  return sorted;
}
fun byArea(a, b) { return a.area() < b.area(); }
fun byPerimeter(a, b) { return a.perimeter() < b.perimeter(); }

print "";
print "== Sorted by area ==";
for (var n = sortBy(shapes, byArea); n != nil; n = n.next) {
  print "  " + n.value.name + " " + fixed(n.value.area(), 2);
}
print "== Sorted by perimeter ==";
for (var n = sortBy(shapes, byPerimeter); n != nil; n = n.next) {
  print "  " + n.value.name + " " + fixed(n.value.perimeter(), 2);
}

// Methods are first-class: a bound method remembers its receiver.
print "";
print "== Bound methods ==";
var sq = Square(10);
var getArea = sq.area;
print "Square(10).area via bound method: " + str(getArea());
sq.w = 2;   // mutate the receiver; the bound method sees the change
print "after sq.w = 2: " + str(getArea());
