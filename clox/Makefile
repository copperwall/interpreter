# Compiler to use.
CC = cc

# Compiler flags:
#   -Wall -Wextra : turn on most warnings
#   -Werror=switch: fail the build if a switch on an enum has no `default:`
#                   and doesn't handle every enumerator
#   -std=c11      : use the C11 standard
#   -g            : emit debug symbols (needed for lldb/the Zed debugger)
#   -MMD          : as a side effect of compiling, write a .d file listing the
#                   headers each .c depends on (skips system headers)
#   -MP           : add a dummy target for each header so deleting/renaming a
#                   header doesn't break the build with a "no rule" error
CFLAGS = -Wall -Wextra -Werror=switch -std=c11 -g -MMD -MP

# All .c files in this directory.
SRCS = $(wildcard *.c)
# Corresponding object file names (foo.c -> foo.o). Each build below puts these
# in its own directory under build/.
OBJS = $(SRCS:.c=.o)
# Name of the final binary.
TARGET = clox

# Default build (plain `make`): the flags above, with objects and the binary in
# build/dev.
DEV_DIR = build/dev
DEV_OBJS = $(addprefix $(DEV_DIR)/,$(OBJS))
# Dependency files (foo.o -> foo.d), generated by -MMD.
DEV_DEPS = $(DEV_OBJS:.o=.d)
DEV_TARGET = $(DEV_DIR)/$(TARGET)

dev: $(DEV_TARGET)

# Link all object files into the final binary.
$(DEV_TARGET): $(DEV_OBJS)
	$(CC) $(CFLAGS) -o $@ $(DEV_OBJS)

# Compile each .c into a .o. This also produces the matching .d file.
$(DEV_DIR)/%.o: %.c | $(DEV_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(DEV_DIR):
	mkdir -p $@

# Optimized release build, in build/release.
#   -O2     : optimize
#   -DNDEBUG: compile out assert()s
# (no -g: no debug symbols)
RELEASE_DIR = build/release
RELEASE_CFLAGS = -Wall -Wextra -Werror=switch -std=c11 -O2 -DNDEBUG -MMD -MP
RELEASE_OBJS = $(addprefix $(RELEASE_DIR)/,$(OBJS))
RELEASE_DEPS = $(RELEASE_OBJS:.o=.d)
RELEASE_TARGET = $(RELEASE_DIR)/$(TARGET)

release: $(RELEASE_TARGET)

$(RELEASE_TARGET): $(RELEASE_OBJS)
	$(CC) $(RELEASE_CFLAGS) -o $@ $(RELEASE_OBJS)

$(RELEASE_DIR)/%.o: %.c | $(RELEASE_DIR)
	$(CC) $(RELEASE_CFLAGS) -c $< -o $@

$(RELEASE_DIR):
	mkdir -p $@

# Profiling build, in build/profile: optimized like release, but with symbols
# and frame pointers so perf can attribute samples and walk the call stack.
# No DEBUG_* tracing, so output stays the same as release.
#   -g                       : debug symbols (function names, source lines)
#   -fno-omit-frame-pointer  : keep frame pointers for cheap, accurate
#                              `perf record -g` stack unwinding
PROFILE_DIR = build/profile
PROFILE_CFLAGS = $(RELEASE_CFLAGS) -g -fno-omit-frame-pointer
PROFILE_OBJS = $(addprefix $(PROFILE_DIR)/,$(OBJS))
PROFILE_DEPS = $(PROFILE_OBJS:.o=.d)
PROFILE_TARGET = $(PROFILE_DIR)/$(TARGET)

profile: $(PROFILE_TARGET)

$(PROFILE_TARGET): $(PROFILE_OBJS)
	$(CC) $(PROFILE_CFLAGS) -o $@ $(PROFILE_OBJS)

$(PROFILE_DIR)/%.o: %.c | $(PROFILE_DIR)
	$(CC) $(PROFILE_CFLAGS) -c $< -o $@

$(PROFILE_DIR):
	mkdir -p $@

# Debug build with bytecode disassembly (DEBUG_PRINT_CODE) and VM execution
# tracing (DEBUG_TRACE_EXECUTION) enabled, in build/debug.
#   -fsanitize=undefined: UBSan, reports undefined behavior at runtime (e.g.
#                         loading a bool that isn't 0 or 1)
DEBUG_DIR = build/debug
DEBUG_CFLAGS = $(CFLAGS) -DDEBUG_PRINT_CODE -DDEBUG_TRACE_EXECUTION  -fsanitize=undefined
DEBUG_OBJS = $(addprefix $(DEBUG_DIR)/,$(OBJS))
DEBUG_DEPS = $(DEBUG_OBJS:.o=.d)
DEBUG_TARGET = $(DEBUG_DIR)/$(TARGET)

debug: $(DEBUG_TARGET)

$(DEBUG_TARGET): $(DEBUG_OBJS)
	$(CC) $(DEBUG_CFLAGS) -o $@ $(DEBUG_OBJS)

$(DEBUG_DIR)/%.o: %.c | $(DEBUG_DIR)
	$(CC) $(DEBUG_CFLAGS) -c $< -o $@

$(DEBUG_DIR):
	mkdir -p $@

# GC debug build: the debug build plus DEBUG_STRESS_GC (collect on every
# allocation) and DEBUG_LOG_GC (log allocations/marking/freeing), in
# build/gc-debug. It has its own directory so its objects, built with different
# -D flags, never get mixed up with the plain debug build's.
GC_DEBUG_DIR = build/gc-debug
GC_DEBUG_CFLAGS = $(DEBUG_CFLAGS) -DDEBUG_STRESS_GC -DDEBUG_LOG_GC
GC_DEBUG_OBJS = $(addprefix $(GC_DEBUG_DIR)/,$(OBJS))
GC_DEBUG_DEPS = $(GC_DEBUG_OBJS:.o=.d)
GC_DEBUG_TARGET = $(GC_DEBUG_DIR)/$(TARGET)

gc-debug: $(GC_DEBUG_TARGET)

$(GC_DEBUG_TARGET): $(GC_DEBUG_OBJS)
	$(CC) $(GC_DEBUG_CFLAGS) -o $@ $(GC_DEBUG_OBJS)

$(GC_DEBUG_DIR)/%.o: %.c | $(GC_DEBUG_DIR)
	$(CC) $(GC_DEBUG_CFLAGS) -c $< -o $@

$(GC_DEBUG_DIR):
	mkdir -p $@

# Run the fib benchmark against the release build.
bench: $(RELEASE_TARGET)
	./$(RELEASE_TARGET) fib_timer.clox

# perf binary. On WSL2 there's no linux-tools package matching the Microsoft
# kernel, so the /usr/bin/perf wrapper refuses to run; use the generic
# linux-tools binary directly if present, else whatever perf is on PATH.
# Override with `make flamegraph PERF=/path/to/perf`.
PERF ?= $(or $(lastword $(wildcard /usr/lib/linux-tools/*/perf)),$(shell command -v perf 2>/dev/null))

# Program to profile and where to write the results. Override with e.g.
# `make flamegraph PROFILE_SCRIPT=fib_timer.clox FLAMEGRAPH=fib.svg`.
PROFILE_SCRIPT ?= bench.lox
FLAMEGRAPH ?= $(basename $(notdir $(PROFILE_SCRIPT))).svg
PERF_DATA = $(PROFILE_DIR)/perf.data

# Run PROFILE_SCRIPT under perf with the profiling build and render a
# flamegraph SVG with inferno (`cargo install inferno`).
#   -F 999       : sample ~999 times per second
#   -e cpu-clock : software timer event; WSL2 doesn't expose hardware counters,
#                  so the default `cycles` event doesn't work there
#   -g           : record call stacks (uses the profile build's frame pointers)
flamegraph: $(PROFILE_TARGET)
	@if [ -z "$(PERF)" ]; then \
		echo "error: perf not found. Install linux-tools-generic or pass PERF=/path/to/perf." >&2; \
		exit 1; \
	fi
	@command -v inferno-flamegraph >/dev/null || { \
		echo "error: inferno not found. Install it with 'cargo install inferno'." >&2; \
		exit 1; \
	}
	$(PERF) record -F 999 -e cpu-clock -g -o $(PERF_DATA) ./$(PROFILE_TARGET) $(PROFILE_SCRIPT)
	$(PERF) script -i $(PERF_DATA) 2>/dev/null | inferno-collapse-perf | \
		inferno-flamegraph --title "clox $(PROFILE_SCRIPT)" > $(FLAMEGRAPH)
	@echo "Wrote $(FLAMEGRAPH)"

# Remove build artifacts.
clean:
	rm -rf build

# clang-format binary. On macOS, falls back to the one bundled with the Xcode
# Command Line Tools if it isn't on PATH. Override with
# `make format CLANG_FORMAT=...`.
ifeq ($(shell uname -s),Darwin)
CLANG_FORMAT ?= $(shell command -v clang-format 2>/dev/null || xcrun --find clang-format 2>/dev/null)
else
CLANG_FORMAT ?= $(shell command -v clang-format 2>/dev/null)
endif

# Format all .c and .h files in place using .clang-format (the same style Zed's
# format-on-save uses via clangd).
format:
	@if [ -z "$(CLANG_FORMAT)" ]; then \
		echo "error: clang-format not found. Install it (e.g. 'sudo apt install clang-format' on Ubuntu/WSL) or pass CLANG_FORMAT=/path/to/clang-format." >&2; \
		exit 1; \
	fi
	$(CLANG_FORMAT) --style=file -i $(wildcard *.c *.h)

# Pull in the auto-generated header dependencies. Each .d file contains rules
# like "main.o: main.c chunk.h common.h", so editing a header now correctly
# forces the dependent .o files to rebuild. The leading '-' means "don't error
# if the .d files don't exist yet" (e.g. on the very first build).
-include $(DEV_DEPS) $(RELEASE_DEPS) $(PROFILE_DEPS) $(DEBUG_DEPS) $(GC_DEBUG_DEPS)

.PHONY: dev clean format release bench profile flamegraph debug gc-debug
